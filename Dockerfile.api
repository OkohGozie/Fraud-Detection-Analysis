# docker-compose.yml — Multi-container deployment
# Three services: pipeline (ETL), api (FastAPI /predict), monitoring (Evidently)
# Run with: docker compose up --build

version: "3.9"

services:
  pipeline:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: fraud-pipeline
    volumes:
      - ./data:/app/data
      - ./docs:/app/docs
    environment:
      - PYTHONUNBUFFERED=1
    command: ["python", "dags/fraud_pipeline_flow.py"]
    restart: "no"

  api:
    build:
      context: .
      dockerfile: api/Dockerfile.api
    container_name: fraud-api
    ports:
      - "8000:8000"
    volumes:
      - ./models:/app/models:ro
    environment:
      - PYTHONUNBUFFERED=1
    depends_on:
      - pipeline
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 5s
      retries: 3

  monitoring:
    build:
      context: .
      dockerfile: monitoring/Dockerfile.monitoring
    container_name: fraud-monitoring
    volumes:
      - ./models:/app/models:ro
      - ./monitoring:/app/monitoring
    environment:
      - PYTHONUNBUFFERED=1
    depends_on:
      - api
    restart: unless-stopped

networks:
  default:
    name: fraud-detection-network
