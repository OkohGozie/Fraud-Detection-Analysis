# api/Dockerfile.api — FastAPI /predict service container
# Updated for Render deployment: listens on Render's dynamic $PORT
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/api/ ./src/api/
COPY models/best_model.joblib models/feature_cols.joblib models/shap_feature_importance.csv ./models/

EXPOSE 8000
CMD uvicorn src.api.main:app --host 0.0.0.0 --port ${PORT:-8000}
